{
  "name": "node-express-realtime-chat",
  "version": "1.0.0",
  "description": "A real-time chat application built with Node.js, Express, MongoDB, Socket.io, and tested with Mocha & Chai",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "mocha --timeout 30000 --exit --require ./test/setup.js \"test/**/*.test.js\""
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "socketio",
    "mocha",
    "chai",
    "chat-application"
  ],
  "author": "EDquest Student",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mongodb-memory-server": "^10.1.3",
    "mocha": "^11.1.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
